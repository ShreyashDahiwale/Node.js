<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
    <title>Homepage</title>
</head>

<body>
    <%- include('./partials/navbar') %>
    <!-- <%= user ? `<h1 class="text-center mt-5">Welcome ${user.fullname}</h1>` : `<h1 class="text-center mt-5">Welcome to Blogify</h1>` %> -->
    <!-- <%= JSON.stringify(blogs) %> -->
     <div class="container mt-4">
        <% blogs.forEach(blog => { %>
            <div class="card mb-3" style="width: 19rem;">
                <% if (blog.coverImageURL) { %>
                    <img src="<%= blog.coverImageURL %>" class="card-img-top" alt="Cover Image">
                <% } %>
                <div class="card-body">
                    <h5 class="card-title"><%= blog.title %></h5>
                    <p class="card-text"><%= blog.body.substring(0, 100) %>...</p>
                    <a href="/blog/<%= blog._id %>" class="btn btn-primary">Read More</a>
                </div>
            </div>
        <% }) %>
     </div>
    <%- include('./partials/scripts') %>
    
</body>

</html>